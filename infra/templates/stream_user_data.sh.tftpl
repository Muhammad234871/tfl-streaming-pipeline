#!/bin/bash
# Runs once, as root, on the instance's first boot. Log: /var/log/cloud-init-output.log
set -euo pipefail

# --- Docker and the compose plugin ------------------------------------------------
dnf install -y docker
systemctl enable --now docker

# Amazon Linux has no compose package: install the plugin binary, pinned to a version.
mkdir -p /usr/local/lib/docker/cli-plugins
curl -fsSL -o /usr/local/lib/docker/cli-plugins/docker-compose \
  https://github.com/docker/compose/releases/download/v2.29.7/docker-compose-linux-x86_64
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

# --- Log in to ECR with the instance role (no keys) -------------------------------
aws ecr get-login-password --region ${region} \
  | docker login --username AWS --password-stdin ${registry}

# --- The production stack ---------------------------------------------------------
mkdir -p /opt/tfl
cat > /opt/tfl/docker-compose.yml <<'COMPOSE'
# Keep each container's logs to 3 x 10 MB, so a 24/7 service never fills the disk.
x-logging: &logging
  driver: json-file
  options:
    max-size: "10m"
    max-file: "3"

services:
  kafka:
    image: apache/kafka:3.9.0
    container_name: kafka
    environment:
      KAFKA_NODE_ID: 1
      KAFKA_PROCESS_ROLES: broker,controller
      KAFKA_CONTROLLER_QUORUM_VOTERS: 1@kafka:9093
      KAFKA_CONTROLLER_LISTENER_NAMES: CONTROLLER
      # Only containers on this instance talk to Kafka: one internal listener, no ports.
      KAFKA_LISTENERS: INTERNAL://:19092,CONTROLLER://:9093
      KAFKA_ADVERTISED_LISTENERS: INTERNAL://kafka:19092
      KAFKA_LISTENER_SECURITY_PROTOCOL_MAP: INTERNAL:PLAINTEXT,CONTROLLER:PLAINTEXT
      KAFKA_INTER_BROKER_LISTENER_NAME: INTERNAL
      KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR: 1
      KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR: 1
      KAFKA_TRANSACTION_STATE_LOG_MIN_ISR: 1
      KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS: 0
      KAFKA_LOG_RETENTION_HOURS: 72
      # The default 1 GB heap is too much on a 2 GB machine.
      KAFKA_HEAP_OPTS: "-Xmx512m -Xms512m"
    volumes:
      - kafka-data:/var/lib/kafka/data
    healthcheck:
      test: ["CMD-SHELL", "/opt/kafka/bin/kafka-broker-api-versions.sh --bootstrap-server kafka:19092 > /dev/null 2>&1"]
      interval: 10s
      timeout: 10s
      retries: 10
    restart: unless-stopped
    logging: *logging

  producer:
    image: ${image}
    container_name: producer
    command: ["python", "-m", "tfl_pipeline.producer"]
    environment:
      KAFKA_BOOTSTRAP_SERVERS: kafka:19092
    restart: unless-stopped
    depends_on:
      kafka:
        condition: service_healthy
    logging: *logging

  consumer:
    image: ${image}
    container_name: consumer
    command: ["python", "-m", "tfl_pipeline.consumer"]
    environment:
      KAFKA_BOOTSTRAP_SERVERS: kafka:19092
      LAKE_URI: ${lake_uri}
      AWS_REGION: ${region}
    restart: unless-stopped
    depends_on:
      kafka:
        condition: service_healthy
    logging: *logging

volumes:
  kafka-data:
COMPOSE

cd /opt/tfl
docker compose up -d