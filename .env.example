# Copy this file to .env and fill in real values. Never commit .env.

# TfL API (free key: https://api-portal.tfl.gov.uk)
TFL_APP_KEY=
TFL_MODES=tube,dlr,elizabeth-line,overground
POLL_INTERVAL_SECONDS=60

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Data lake: a local folder for now, later s3://your-bucket-name
LAKE_URI=./data/lake
FLUSH_MAX_RECORDS=50000
FLUSH_MAX_SECONDS=300

# AWS
AWS_REGION=eu-north-1
